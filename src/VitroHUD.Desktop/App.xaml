<Application x:Class="VitroHUD.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#C4DCB7"/>
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D1E5C8"/>
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B4CDA8"/>
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#F7FAF4"/>
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E6EEE0"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
